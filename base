void saveTickets(void){
    FILE *fp = fopen("tickets.csv", "w");
    if(fp == NULL){
        printf("Error opening file for writing.\n");
        return;
    }
     fprintf(fp, "Ticket ID, Name, Contact Number, Age, Gender, Date, Seat Number, Source, Destination, Duration, Route Display, Route Distance, Price, Discount,Total Price, Booking Status\n");
    for(int i = 0; i < count; i++){
        fprintf(fp, "%d,%s,%s,%d,%s,%s,%d,%s,%s,%d,%s,%d,%.2f,%d,%.2f,%s\n", 
                                                                    tickets[i].ticket_id, 
                                                                    tickets[i].name,tickets[i].contact, 
                                                                    tickets[i].age, tickets[i].gender, 
                                                                    tickets[i].date,
                                                                    tickets[i].seatNumber, 
                                                                    tickets[i].source, 
                                                                    tickets[i].destination, 
                                                                    tickets[i].duration, 
                                                                    tickets[i].routeDisplay, 
                                                                    tickets[i].routeDistance, 
                                                                    tickets[i].price, 
                                                                    tickets[i].discount, 
                                                                    tickets[i].total_price, 
                                                                    tickets[i].bookingStatus==1?"Booked":"Cancelled");
    }
    fclose(fp);
}




