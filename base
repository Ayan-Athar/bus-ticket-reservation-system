/*==============================================================================================================

                                      CONDITION CHECK FUNCTIONS

================================================================================================================*/

static int isValidName(const char *s){
    int letters = 0;
    for(int i = 0; s[i]; i++){
        unsigned char c = (unsigned char)s[i];
        if(isalpha(c))
            letters++;
        else if(c != ' ' && c != '.' && c != '-' && c != '\'')
            return 0;              // digits, commas and other symbols
    }
    return letters > 2;
}

static int isValidContact(const char *s){
    if(strlen(s)!=11)
    return 0;
    if(s[0]!='0' || s[1]!='3')
    return 0;
    for(int i=0;i<11;i++){
        if(!isdigit((unsigned char)s[i]))
        return 0;
    }
    return 1;
}

static int isValidAge(int age){
    return age>0 && age<=120;
}

static int isValidGender(const char *s){
    if(strcasecmp_custom(s, "m") == 0 || strcasecmp_custom(s, "male") == 0)
        return 1;
    if(strcasecmp_custom(s, "f") == 0 || strcasecmp_custom(s, "female") == 0)
        return 1;
    if(strcasecmp_custom(s, "other") == 0)
        return 1;
    return 0;
}

static int isValidDate(char *s){
    int d, m, y;
    char extra;
    if(sscanf(s, "%d/%d/%d%c", &d, &m, &y, &extra) != 3){
        printf("Use the format dd/mm/yyyy.\n");
        return 0;
    }
    if(m < 1 || m > 12 || d < 1 || d > 31){
        printf("Invalid day or month!\n");
        return 0;
    }
    if((m == 4 || m == 6 || m == 9 || m == 11) && d > 30){
        printf("This month only has 30 days!\n");
        return 0;
    }
    if(m == 2 && d > 28){
        printf("February has at most 28 days here!\n");
        return 0;
    }

    /* today's date from the system clock */
    time_t now = time(NULL);
    struct tm *t = localtime(&now);
    int today = (t->tm_year + 1900) * 365 + (t->tm_mon + 1) * 30 + t->tm_mday;
    int user  = y * 365 + m * 30 + d;

    if(user < today){
        printf("Past dates are not allowed.\n");
        return 0;
    }
    if(user == today){
        printf("No booking possible for today.\n");
        return 0;
    }
    if(user > today + 60){
        printf("Bookings are only open up to 2 months ahead.\n");
        return 0;
    }

    sprintf(s, "%02d/%02d/%04d", d, m, y);   // store as dd/mm/yyyy
    return 1;
}

static int strcasecmp_custom(const char *s1, const char *s2) {
    while (*s1 && *s2) {
        if (tolower((unsigned char)*s1) != tolower((unsigned char)*s2))
            return 1;
        s1++;
        s2++;
    }
    return tolower((unsigned char)*s1) - tolower((unsigned char)*s2);
}
 
static void clearInput(void){
    int c;
    while((c = getchar()) != '\n' && c != EOF);
}
 
/* Returns 1 if the seat is already booked on the same date and route */
static int isSeatTaken(int seat, const char *date, const char *src, const char *dst){
    for(int i = 0; i < count; i++){
        if(tickets[i].bookingStatus == BOOKED && tickets[i].seatNumber == seat && strcmp(tickets[i].date, date) == 0 && strcasecmp_custom(tickets[i].source, src) == 0 && strcasecmp_custom(tickets[i].destination, dst) == 0)
            return 1;
    }
    return 0;
}
